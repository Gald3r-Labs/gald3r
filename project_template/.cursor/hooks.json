{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/g-hk-session-start.py"
      },
      {
        "command": "python .cursor/hooks/g-hk-pre-session-trace.py",
        "_hook_md": ".cursor/hooks/g-hk-pre-session-trace.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-vault-resolve.py",
        "_hook_md": ".cursor/hooks/g-hk-vault-resolve.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-vault-migrate.py --if-diverged",
        "_hook_md": ".cursor/hooks/g-hk-vault-migrate.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-agent-worktree-janitor.py -EventName SessionStart",
        "_hook_md": ".cursor/hooks/g-hk-agent-worktree-janitor.md"
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/g-hk-agent-complete.py"
      },
      {
        "command": "python .cursor/hooks/g-hk-nightly-learn.py"
      },
      {
        "command": "python .cursor/hooks/g-hk-session-end.py"
      },
      {
        "command": "python .cursor/hooks/g-hk-encoding-normalize.py -Quiet",
        "_hook_md": ".cursor/hooks/g-hk-encoding-normalize.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-ggo-stop-detect.py",
        "_hook_md": ".cursor/hooks/g-hk-ggo-stop-detect.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-goal-stop-detect.py",
        "_hook_md": ".cursor/hooks/g-hk-goal-stop-detect.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-post-session-trace.py",
        "_hook_md": ".cursor/hooks/g-hk-post-session-trace.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-crash-record.py --component-type hook --component-name stop-chain --trigger-source hooks.json",
        "_hook_md": ".cursor/hooks/g-hk-crash-record.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-graph-update.py",
        "_hook_md": ".cursor/hooks/g-hk-graph-update.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-vault-verify.py",
        "_hook_md": ".cursor/hooks/g-hk-vault-verify.md"
      },
      {
        "command": "python .cursor/hooks/raw-inbox-watcher.py --hook-mode",
        "_hook_md": ".cursor/hooks/raw-inbox-watcher.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-vault-reindex.py",
        "_hook_md": ".cursor/hooks/g-hk-vault-reindex.md"
      },
      {
        "command": "python .cursor/hooks/g-hk-agent-worktree-janitor.py -EventName Stop",
        "_hook_md": ".cursor/hooks/g-hk-agent-worktree-janitor.md"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/g-hk-validate-shell.py"
      }
    ],
    "preToolUse": [
      {
        "command": "python .cursor/hooks/g-hk-pre-tool-call-gald3r-guard.py",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Patch|ApplyPatch|str_replace_editor"
      },
      {
        "command": "python .cursor/hooks/g-hk-pre-tool-call-prd-freeze.py",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Patch|ApplyPatch|str_replace_editor"
      },
      {
        "command": "python .cursor/hooks/g-hk-pre-tool-call-member-gald3r-guard.py",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Patch|ApplyPatch|str_replace_editor"
      },
      {
        "command": "python .cursor/hooks/g-hk-pre-tool-call.py",
        "matcher": "Bash|Shell|Terminal|run_terminal_cmd",
        "_hook_md": ".cursor/hooks/g-hk-pre-tool-call.md"
      }
    ],
    "postToolUse": [
      {
        "command": "python .cursor/hooks/g-hk-on-tool-end.py",
        "_hook_md": ".cursor/hooks/g-hk-on-tool-end.md"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python .cursor/hooks/g-hk-on-user-prompt-submit.py",
        "_hook_md": ".cursor/hooks/g-hk-on-user-prompt-submit.md"
      }
    ]
  }
}
