{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .qwen/hooks/g-hk-on-session-start.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .qwen/hooks/g-hk-on-session-end.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .qwen/hooks/g-hk-on-user-prompt-submit.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .qwen/hooks/g-hk-on-tool-start.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .qwen/hooks/g-hk-on-tool-end.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .qwen/hooks/g-hk-on-stop.py"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "gald3r": {
      "command": "gald3r",
      "args": [
        "mcp",
        "serve"
      ]
    }
  }
}
