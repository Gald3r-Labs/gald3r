{
  "hooks": {
    "pre_user_prompt": [
      {
        "command": "python3 .windsurf/hooks/g-hk-on-user-prompt-submit.py",
        "powershell": "python .windsurf/hooks/g-hk-on-user-prompt-submit.py"
      }
    ],
    "pre_run_command": [
      {
        "command": "python3 .windsurf/hooks/g-hk-on-tool-start.py",
        "powershell": "python .windsurf/hooks/g-hk-on-tool-start.py"
      }
    ],
    "pre_write_code": [
      {
        "command": "python3 .windsurf/hooks/g-hk-on-tool-start.py",
        "powershell": "python .windsurf/hooks/g-hk-on-tool-start.py"
      }
    ],
    "post_run_command": [
      {
        "command": "python3 .windsurf/hooks/g-hk-on-tool-end.py",
        "powershell": "python .windsurf/hooks/g-hk-on-tool-end.py"
      }
    ],
    "post_write_code": [
      {
        "command": "python3 .windsurf/hooks/g-hk-on-tool-end.py",
        "powershell": "python .windsurf/hooks/g-hk-on-tool-end.py"
      }
    ],
    "post_cascade_response": [
      {
        "command": "python3 .windsurf/hooks/g-hk-on-stop.py",
        "powershell": "python .windsurf/hooks/g-hk-on-stop.py"
      }
    ]
  }
}
