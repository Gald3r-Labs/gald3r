{
  "post_tool_use": [
    {
      "matcher": "*",
      "hooks": [
        {
          "command": "python .openhands/hooks/g-hk-on-tool-end.py"
        }
      ]
    }
  ],
  "pre_tool_use": [
    {
      "matcher": "*",
      "hooks": [
        {
          "command": "python .openhands/hooks/g-hk-on-tool-start.py"
        }
      ]
    }
  ],
  "session_end": [
    {
      "matcher": "*",
      "hooks": [
        {
          "command": "python .openhands/hooks/g-hk-on-session-end.py"
        }
      ]
    }
  ],
  "session_start": [
    {
      "matcher": "*",
      "hooks": [
        {
          "command": "python .openhands/hooks/g-hk-on-session-start.py"
        }
      ]
    }
  ],
  "stop": [
    {
      "matcher": "*",
      "hooks": [
        {
          "command": "python .openhands/hooks/g-hk-on-stop.py"
        }
      ]
    }
  ],
  "user_prompt_submit": [
    {
      "matcher": "*",
      "hooks": [
        {
          "command": "python .openhands/hooks/g-hk-on-user-prompt-submit.py"
        }
      ]
    }
  ]
}
