{
  "version": "1.0.0",
  "enabled": true,
  "name": "g-hk-component-tag-check",
  "description": "Runs the gald3r g-hk-component-tag-check hook script (manually triggered via the Kiro Agent Hooks panel).",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "python .kiro/hooks/g-hk-component-tag-check.py"
  }
}
