{
  "version": "1.0.0",
  "enabled": true,
  "name": "g-hk-pre-tool-call-prd-freeze",
  "description": "Runs the gald3r g-hk-pre-tool-call-prd-freeze hook script (manually triggered via the Kiro Agent Hooks panel).",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "python .kiro/hooks/g-hk-pre-tool-call-prd-freeze.py"
  }
}
